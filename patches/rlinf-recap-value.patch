+def _fix_filtered_episode_data_index(dataset: Any, episodes: list[int]) -> None:
+    """Map LeRobot v2.1's compact subset bounds back to original episode ids."""
+    index = getattr(dataset, "episode_data_index", None)
+    if index is None:  # LeRobot v3.0 no longer has this field or the bug.
+        return
+    if not episodes or len(episodes) != len(set(episodes)):
+        raise ValueError("episodes must be a non-empty list of unique indices")
+
+    old_from = index["from"]
+    old_to = index["to"]
+    if len(old_from) != len(episodes) or len(old_to) != len(episodes):
+        raise RuntimeError("LeRobot filtered episode bounds do not match episodes")
+
+    new_size = max(episodes) + 1
+    new_from = torch.full((new_size,), -1, dtype=old_from.dtype)
+    new_to = torch.full((new_size,), -1, dtype=old_to.dtype)
+    for local_index, episode_index in enumerate(episodes):
+        new_from[episode_index] = old_from[local_index]
+        new_to[episode_index] = old_to[local_index]
+    index["from"] = new_from
+    index["to"] = new_to
+
+
