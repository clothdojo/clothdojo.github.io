#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "piper_dual"
    doc = """Converted Piper robot asset; generated from the upstream URDF source."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "piper_dual"
{
    over "Physics"
